---
import { type CollectionEntry, getCollection } from 'astro:content';
import PostPreview from '../../components/PostPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPostsByDateDesc } from '../../utils/post-utils';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    const tags = new Map<string, string>();

    for (const post of posts) {
        if (!post.data.tag || !post.data.tagSlug) continue;
        tags.set(post.data.tagSlug, post.data.tag);
    }

    return Array.from(tags.entries()).map(([slug, name]) => ({
        params: { tag: slug },
        props: {
            tagName: name,
            posts: posts.filter((post) => post.data.tagSlug === slug).sort(sortPostsByDateDesc)
        }
    }));
}

const { tagName, posts } = Astro.props as { tagName: string; posts: CollectionEntry<'blog'>[] };
---

<BaseLayout title={tagName} description={`Posts tagged ${tagName}`}>
    <main class="px-4 py-12 grow sm:px-8 sm:py-16">
        <div class="max-w-3xl mx-auto mb-8 sm:mb-12">
            <h1 class="text-4xl font-bold text-slate-900 sm:text-5xl">{tagName}</h1>
        </div>
        <div class="max-w-3xl mx-auto xl:max-w-6xl">
            {posts.map((post) => <PostPreview post={post} />)}
        </div>
    </main>
</BaseLayout>
