---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import CustomImage from '../components/CustomImage.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReadNextPostPreview from '../components/ReadNextPostPreview.astro';
import Subscribe from '../components/Subscribe.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortPostsByDateDesc } from '../utils/post-utils';

type PageProps = { entryType: 'page'; page: CollectionEntry<'pages'> };
type LegacyPostProps = {
    entryType: 'legacy-post';
    post: CollectionEntry<'blog'>;
    prevPost: CollectionEntry<'blog'> | null;
    nextPost: CollectionEntry<'blog'> | null;
};

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    const posts = (await getCollection('blog')).sort(sortPostsByDateDesc);
    const pagePaths = pages.map((page) => ({
        params: { id: page.id },
        props: { entryType: 'page', page }
    }));
    const postCount = posts.length;
    const legacyPostPaths = posts
        .filter((post) => post.data.permalink)
        .map((post, index) => ({
            params: { id: post.data.permalink?.replace(/^\/|\/$/g, '') ?? post.id },
            props: {
                entryType: 'legacy-post',
                post,
                prevPost: index + 1 !== postCount ? posts[index + 1] : null,
                nextPost: index !== 0 ? posts[index - 1] : null
            }
        }));

    return [...pagePaths, ...legacyPostPaths];
}

const props = Astro.props as PageProps | LegacyPostProps;

let page: CollectionEntry<'pages'> | undefined;
let post: CollectionEntry<'blog'> | undefined;
let prevPost: CollectionEntry<'blog'> | null = null;
let nextPost: CollectionEntry<'blog'> | null = null;
let Content;
let title: string;
let description: string | undefined;
let image;
let pageType: 'website' | 'article' = 'website';

if (props.entryType === 'page') {
    page = props.page;
    const rendered = await render(page);
    Content = rendered.Content;
    title = page.data.seo?.title ?? page.data.title;
    description = page.data.seo?.description;
    image = page.data.seo?.image ?? page.data.featureImage;
} else {
    post = props.post;
    prevPost = props.prevPost;
    nextPost = props.nextPost;
    const rendered = await render(post);
    Content = rendered.Content;
    title = post.data.seo?.title ?? post.data.title;
    description = post.data.seo?.description ?? post.data.excerpt;
    image = post.data.seo?.image ?? post.data.featureImage;
    pageType = 'article';
}

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout title={title} description={description} image={image} pageType={pageType}>
    {
        page ? (
            <main class="px-4 py-12 grow sm:px-8 sm:py-16">
                <article class="max-w-6xl mx-auto">
                    <header class="max-w-3xl mx-auto mb-9">
                        <h1 class="text-4xl font-bold text-slate-900 sm:text-5xl">{page.data.title}</h1>
                    </header>
                    {
                        page.data.featureImage?.src && (
                            <figure class="mb-9">
                                <CustomImage
                                    {...page.data.featureImage}
                                    class="w-full rounded-md"
                                    widths={[480, 640, 768, 960, 1200, 1600]}
                                    sizes="(min-width: 1216px) 1152px, calc(100vw - 32px)"
                                />
                                {page.data.featureImage.caption && (
                                    <figcaption class="mt-1.5 text-xs">{page.data.featureImage.caption}</figcaption>
                                )}
                            </figure>
                        )
                    }
                    <div class="max-w-3xl mx-auto">
                        <div class="prose prose-slate sm:prose-lg max-w-none">
                            <Content />
                        </div>
                    </div>
                </article>
            </main>
        ) : (
            <main class="grow px-4 py-12 sm:px-8 sm:py-16">
                <article class="mx-auto mb-12 max-w-6xl sm:mb-16">
                    <header class="mx-auto mb-6 max-w-3xl sm:mb-8">
                        <div class="mb-3 text-sm tracking-wider text-slate-500 uppercase">
                            {
                                post?.data.isFeatured && (
                                    <>
                                        <span class="text-primary">Featured</span>
                                        {' / '}
                                    </>
                                )
                            }
                            {post && <FormattedDate date={post.data.publishDate} />}
                            {
                                post?.data.updatedDate && (
                                    <>
                                        {' '}
                                        <span>
                                            (Updated on <FormattedDate date={post.data.updatedDate} />)
                                        </span>
                                    </>
                                )
                            }
                        </div>
                        <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl md:text-5xl">{post?.data.title}</h1>
                    </header>
                    {
                        post?.data.featureImage?.src && (
                            <figure class="my-6 sm:my-8 lg:my-12">
                                <CustomImage
                                    {...post.data.featureImage}
                                    class="w-full rounded-lg"
                                    widths={[480, 640, 768, 960, 1200, 1600]}
                                    sizes="(min-width: 1216px) 1152px, calc(100vw - 32px)"
                                />
                                {post.data.featureImage.caption && (
                                    <figcaption class="mt-1.5 text-xs sm:text-sm">{post.data.featureImage.caption}</figcaption>
                                )}
                            </figure>
                        )
                    }
                    <div class="mx-auto max-w-3xl">
                        <div class="prose prose-slate sm:prose-lg max-w-none">
                            <Content />
                        </div>
                        <div class="mt-8 flex flex-wrap gap-x-3 gap-y-1 text-sm sm:mt-12 sm:text-base">
                            <span class="font-semibold">Share:</span>
                            <a
                                class="text-primary transition duration-300 hover:text-slate-700"
                                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}&summary=${encodeURIComponent(title)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Share on LinkedIn">LinkedIn</a
                            >
                            <a
                                class="text-primary transition duration-300 hover:text-slate-700"
                                href={`https://x.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(title)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Share on X">X/Twitter</a
                            >
                        </div>
                    </div>
                </article>
                {
                    (prevPost || nextPost) && (
                        <div class="mx-auto mb-12 max-w-3xl sm:mb-16">
                            <h2 class="after:bg-primary mb-8 text-sm tracking-wider text-slate-900 uppercase after:mt-4 after:block after:h-px after:w-16 after:content-[''] sm:mb-12">
                                Read Next
                            </h2>
                            {nextPost && <ReadNextPostPreview post={nextPost} />}
                            {prevPost && <ReadNextPostPreview post={prevPost} />}
                        </div>
                    )
                }
                <Subscribe class="mt-16 mb-12 sm:mt-24 sm:mb-16" />
            </main>
        )
    }
</BaseLayout>
